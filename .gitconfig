[core]
	editor = nvim
    #pager = delta

[user]
	name = Sisir Ghimire Chettri
	email = schettri@cropvue.com

[github]
    user = tuxsisir

[alias]
    s = status
    di = diff
    df = diff --staged

[delta]
    line-numbers = true

[pull]
    ff = false

[init]
	defaultBranch = main

# machine-specific overrides (e.g. work email), not tracked
[include]
    path = ~/.gitconfig.local
