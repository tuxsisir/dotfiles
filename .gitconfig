[core]
    editor = nvim
    #pager = delta

[user]
    name = Sisir Ghimire Chettri
    email = contact@sisir.net

[github]
    user = tuxsisir

[alias]
    s = status
    di = diff
    df = diff --staged

[delta]
    line-numbers = true

[pull]
    ff = false

[init]
    defaultBranch = main

# machine-specific overrides (e.g. work email), not tracked
[include]
    path = ~/.gitconfig.local

# personal repos keep the personal identity even on the work Mac; after the
# include above so it wins over ~/.gitconfig.local. Matched by remote (any
# tuxsisir repo, wherever it's cloned) and by path for ~/dotfiles.
[includeIf "hasconfig:remote.*.url:git@github.com:tuxsisir/**"]
    path = ~/.config/git/personal
[includeIf "hasconfig:remote.*.url:https://github.com/tuxsisir/**"]
    path = ~/.config/git/personal
[includeIf "gitdir:~/dotfiles/"]
    path = ~/.config/git/personal
[includeIf "gitdir:~/personal/"]
    path = ~/.config/git/personal
